# /opt/vrmm/.env — secrets file loaded by systemd EnvironmentFile
# chmod 640, chown root:vrmm
# Copy this to /opt/vrmm/.env on the VM and fill in real values

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/vrmm_prod
SPRING_DATASOURCE_USERNAME=vrmm_app
SPRING_DATASOURCE_PASSWORD=CHANGE_ME

# Generate with: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_64_CHAR_MINIMUM_RANDOM_STRING

SUPPORT_EMAIL=your-support-gmail@gmail.com
APP_PASSWORD=your-gmail-app-password

APP_FRONTEND_URL=https://vrmm.eng.uwo.ca
CORS_ALLOWED_ORIGINS=https://vrmm.eng.uwo.ca

# OIDC (fill in after receiving client credentials from WTS IT)
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_TENANT_ID=
